  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  factType FactType  @relation(fields: [factTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, factDate])
  @@index([tenantId, employeeId])
  @@index([factTypeId])
  @@map("facts")
}

/// Займы — Verifix «Займы» / «Заем (создание)»
model EmployeeLoan {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  employeeId     String     @map("employee_id") @db.Uuid
  /// Номер займа
  number         String     @default("")
  /// Дата займа
  loanDate       DateTime   @default(now()) @map("loan_date") @db.Date
  contractNumber String?    @map("contract_number")
  contractDate   DateTime?  @map("contract_date") @db.Date
  currency       String     @default("UZS")
  principal      Decimal    @db.Decimal(14, 2)
  remaining      Decimal    @db.Decimal(14, 2)
  monthlyPayment Decimal?   @map("monthly_payment") @db.Decimal(14, 2)
  /// С (период)
  startDate      DateTime   @map("start_date") @db.Date
  /// До (период)
  endDate        DateTime?  @map("end_date") @db.Date
  status         LoanStatus @default(draft)
  note           String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@index([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, loanDate])
  @@map("employee_loans")
}

