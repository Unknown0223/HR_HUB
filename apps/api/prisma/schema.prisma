model OneTimeAccrualDoc {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  /// accrual | deduction
  kind          String            @default("accrual")
  number        String            @default("")
  docDate       DateTime          @default(now()) @map("doc_date") @db.Date
  month         DateTime          @default(now()) @db.Date
  title         String?
  divisionId    String?           @map("division_id") @db.Uuid
  basis         String?
  note          String?
  currency      String            @default("UZS")
  /// value | percent | formula
  calcType      String            @default("value") @map("calc_type")
  percent       Decimal           @default(0) @db.Decimal(8, 4)
  formula       String?
  useOneForAll  Boolean           @default(false) @map("use_one_for_all")
  attachments   Json?
  totalAmount   Decimal           @default(0) @map("total_amount") @db.Decimal(14, 2)
  status        DocumentLifecycle @default(draft)
  postedAt      DateTime?         @map("posted_at")
  createdByName String?           @map("created_by_name")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  division Division?            @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  lines    OneTimeAccrualLine[]

  @@unique([tenantId, number])
  @@index([tenantId, kind])
  @@index([tenantId, docDate])
  @@index([tenantId, status])
  @@map("one_time_accrual_docs")
}

model OneTimeAccrualLine {
  id         String    @id @default(uuid()) @db.Uuid
  docId      String    @map("doc_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  typeId     String?   @map("type_id") @db.Uuid
  typeName   String?   @map("type_name")
  lineDate   DateTime? @map("line_date") @db.Date
  amount     Decimal   @default(0) @db.Decimal(14, 2)
  note       String?
  sortOrder  Int       @default(0) @map("sort_order")

  doc      OneTimeAccrualDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([employeeId])
  @@map("one_time_accrual_lines")
}

/// Verifix «Бонусные начисления» — Факт / КПЭ
