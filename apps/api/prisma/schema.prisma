generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  platform_admin
  tenant_admin
  hr
  manager
  employee
}

enum EmploymentStatus {
  active
  dismissed
  leave
}

enum SalaryMarketLevel {
  below_market
  at_market
  above_market
}

enum EmploymentType {
  staff
  gph
}

enum PunchDirection {
  IN
  OUT
  AUTO
}

enum DayStatus {
  on_time
  late
  absent
  not_started
  day_off
  leave
}

enum RequestStatus {
  draft
  pending
  approved
  rejected
  cancelled
}

enum RequestType {
  absence
  schedule_change
  roster_change
  overtime
  location
  hr_change
}

/// Verifix «Заявки на кадровые изменения» kinds
enum HrChangeKind {
  open_position
  hire
  transfer
  transfer_batch
  dismiss
}

enum DocumentType {
  hire
  transfer
  dismiss
  name_change
  wage_change
  other
}

enum FaceSyncStatus {
  pending
  syncing
  synced
  failed
}

enum PayrollPeriodStatus {
  open
  calculated
  closed
}

/// Verifix document «провести» lifecycle (draft → posted)
enum DocumentLifecycle {
  draft
  posted
  cancelled
}

enum AdvanceStatus {
  draft
  paid
  cancelled
}

enum PayrollLineType {
  base
  bonus
  penalty
  advance
  deduction
  overtime
  one_time
  other
}

/// Verifix «Все начисления» document kinds
enum PayrollAccrualKind {
  salary_contributions
  sick_leave
  travel
  vacation
  all_types
}

enum IntegrationType {
  hikvision
  webhook
  onec
  bank
  custom
}

enum ClearanceStatus {
  open
  in_progress
  completed
  cancelled
}

enum ClearanceItemStatus {
  pending
  done
  skipped
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum IncidentStatus {
  open
  investigating
  resolved
  closed
}

/// Verifix: Действия по инциденту
enum IncidentAction {
  verbal_warning
  written_warning
  fine
}

enum NotificationKind {
  approval
  info
  alert
  system
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  divisions      Division[]
  positions      Position[]
  employees      Employee[]
  persons        Person[]
  locations      Location[]
  devices        Device[]
  attendanceMarks AttendanceMark[]
  attendanceDays AttendanceDay[]
  problemMarks   ProblemMark[]
  absenceTypes   AbsenceType[]
  absences       Absence[]
  hrRequests     HrRequest[]
  hrDocuments    HrDocument[]
  hrChangeRequests HrChangeRequest[]
  workSchedules  WorkSchedule[]
  productionCalendars ProductionCalendar[]
  qrCodes        QrCode[]
  payrollPolicies PayrollPolicy[]
  finePolicies    FinePolicy[]
  allowancePolicies AllowancePolicy[]
  timesheetSheets TimesheetSheet[]
  payrollPeriods  PayrollPeriod[]
  payrollLines    PayrollLine[]
  payrollAdvances PayrollAdvance[]
  payrollAccrualDocs PayrollAccrualDoc[]
  payrollLedgerEntries PayrollLedgerEntry[]
  settlementAudits   SettlementAudit[]
  payrollSheets      PayrollSheet[]
  payrollSheetAudits PayrollSheetAudit[]
  payrollSheetSetting PayrollSheetSetting?
  payrollManualOps    PayrollManualOp[]
  payrollManualAudits PayrollManualAudit[]
  tenantSetting   TenantSetting?
  dictionaries    Dictionary[]
  personDocuments PersonDocument[]
  integrations    ExternalIntegration[]
  auditLogs       AuditLog[]
  clearanceTemplates ClearanceTemplate[]
  clearanceSheets    ClearanceSheet[]
  incidentTypes      IncidentType[]
  incidents          Incident[]
  notifications      Notification[]

  divisionGroups     DivisionGroup[]
  positionGroups     PositionGroup[]
  grades             Grade[]
  employeeGradeHistory EmployeeGradeHistory[]
  gradePromotions    GradePromotion[]
  gradePromotionRecommendations GradePromotionRecommendation[]
  careerPaths        CareerPath[]
  tariffGroups       TariffGroup[]
  tariffApprovals    TariffGroupApproval[]
  staffPositions     StaffPosition[]
  dismissalReasons   DismissalReason[]
  gphContracts       GphContract[]
  gphServices        GphService[]
  nameChanges        EmployeeNameChange[]
  wageChanges        WageChange[]
  locationTypes      LocationType[]
  timesheetAdjustments TimesheetAdjustment[]
  timesheetCorrections TimesheetCorrection[]
  scheduleShifts     ScheduleShift[]
  scheduleShiftAssignments ScheduleShiftAssignment[]
  scheduleOverrides  EmployeeScheduleOverride[]
  individualSchedules IndividualSchedule[]
  positionSchedules  PositionSchedule[]
  positionScheduleDocs PositionScheduleDoc[]
  workRosters        WorkRoster[]
  internalTrips      InternalTrip[]
  gpsTrackPoints     GpsTrackPoint[]
  paymentOrders      PaymentOrder[]
  accountPairs       AccountPair[]
  settlements        Settlement[]
  salesCommissionPolicies SalesCommissionPolicy[]
  salesCommissionAccruals SalesCommissionAccrual[]
  oneTimeAccrualDocs OneTimeAccrualDoc[]
  bonusAccrualDocs   BonusAccrualDoc[]
  employeeLoans      EmployeeLoan[]
  travelExpenseReports TravelExpenseReport[]
  candidates         Candidate[]
  vacancies          Vacancy[]
  employeeRelatives  EmployeeRelative[]
  employeeCertificates EmployeeCertificate[]
  employeeTenures      EmployeeTenure[]
  employeeWorkplaces   EmployeeWorkplace[]
  employeeAwards       EmployeeAward[]
  employeeFiles        EmployeeFile[]
  employeeInventory    EmployeeInventory[]
  employeeCars         EmployeeCar[]
  employeeMarkBlocks   EmployeeMarkBlock[]
  employeeAccessGrants EmployeeAccessGrant[]
  employeeBankAccounts EmployeeBankAccount[]
  employeeBankCards    EmployeeBankCard[]
  timeTypes          TimeType[]
  reportTemplates    ReportTemplate[]
  positionTemplates  PositionTemplate[]
  dynamicFields      DynamicField[]
  dynamicObjects     DynamicObject[]
  factTypes          FactType[]
  facts              Fact[]
  accrualTypes       AccrualType[]
  deductionTypes     DeductionType[]
  hireDocumentExceptions HireDocumentException[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(employee)
  isActive     Boolean  @default(true) @map("is_active")
  /// Verifix profile: login, photo, orgs, catalog roles, phone…
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([tenantId])
  @@map("users")
}

model Division {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  parentId        String?   @map("parent_id") @db.Uuid
  managerId       String?   @map("manager_id") @db.Uuid
  divisionGroupId String?   @map("division_group_id") @db.Uuid
  locationId      String?   @map("location_id") @db.Uuid
  scheduleId      String?   @map("schedule_id") @db.Uuid
  code            String
  name            String
  sortOrder       Int       @default(0) @map("sort_order")
  openedAt        DateTime? @map("opened_at") @db.Date
  closedAt        DateTime? @map("closed_at") @db.Date
  legalEntity     String?   @map("legal_entity")
  createdByLabel  String?   @map("created_by_label")
  updatedByLabel  String?   @map("updated_by_label")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent        Division?      @relation("DivisionTree", fields: [parentId], references: [id])
  children      Division[]     @relation("DivisionTree")
  manager       Employee?      @relation("DivisionManager", fields: [managerId], references: [id], onDelete: SetNull)
  divisionGroup DivisionGroup? @relation(fields: [divisionGroupId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  schedule      WorkSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  employees     Employee[]
  staffPositions StaffPosition[]
  gphContracts  GphContract[]
  timesheetCorrections TimesheetCorrection[]
  timesheetSheets TimesheetSheet[]
  payrollAccrualDocs PayrollAccrualDoc[]
  payrollSheets PayrollSheet[]
  salesCommissionAccruals SalesCommissionAccrual[]
  oneTimeAccrualDocs OneTimeAccrualDoc[]
  bonusAccrualDocs   BonusAccrualDoc[]
  individualSchedules IndividualSchedule[]
  positionScheduleDocs PositionScheduleDoc[]
  hrChangeRequests HrChangeRequest[]
  clearanceTemplates ClearanceTemplate[]
  gradePromotions GradePromotion[]
  gradePromotionRecommendations GradePromotionRecommendation[]
  tripsAsRecipient InternalTrip[] @relation("TripRecipient")
  tripsAsSender    InternalTrip[] @relation("TripSender")
  positionTemplates PositionTemplate[]
  facts            Fact[]
  hireDocumentExceptions HireDocumentException[]
  finePolicies           FinePolicy[]
  allowancePolicies      AllowancePolicy[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([managerId])
  @@index([locationId])
  @@index([scheduleId])
  @@map("divisions")
}

model Position {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  positionGroupId String?  @map("position_group_id") @db.Uuid
  code            String
  name            String
  sortOrder       Int      @default(0) @map("sort_order")
  description     String?
  /// Роль (Verifix)
  role            String?
  /// Счет затрат
  costAccount     String?  @map("cost_account")
  /// Классификатор mehnat
  laborClassifier String?  @map("labor_classifier")
  /// Псевдонимы: [{ grade, alias }]
  aliases         Json?
  createdByLabel  String?  @map("created_by_label")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  positionGroup PositionGroup? @relation(fields: [positionGroupId], references: [id])
  employees     Employee[]
  staffPositions StaffPosition[]
  careerSteps   CareerPathStep[]
  positionSchedules PositionSchedule[]
  positionScheduleDocLines PositionScheduleDocLine[]
  positionTemplates PositionTemplate[]
  hrChangeRequests HrChangeRequest[]
  clearanceTemplates ClearanceTemplate[]
  gradePromotionRecommendations GradePromotionRecommendation[]
  internalTrips InternalTrip[]
  hireDocumentExceptions HireDocumentException[]
  finePolicies           FinePolicy[]
  salesCommissionPolicies SalesCommissionPolicy[]
  salesCommissionAccruals SalesCommissionAccrual[]
  salesCommissionLines    SalesCommissionLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("positions")
}

model Person {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  middleName String?  @map("middle_name")
  birthDate  DateTime? @map("birth_date") @db.Date
  gender     String?
  pinfl      String?
  passport   String?
  phone      String?
  email      String?
  /// Verifix directory fields
  code                 String?  @map("code")
  inn                  String?
  inps                 String?
  nationality          String?
  regionId             String?  @map("region_id") @db.Uuid
  addressResidence     String?  @map("address_residence") @db.Text
  addressRegistration  String?  @map("address_registration") @db.Text
  photoUrl             String?  @map("photo_url")
  useForFaceRecognition Boolean @default(true) @map("use_for_face_recognition")
  isKeyPerson          Boolean  @default(false) @map("is_key_person")
  accessAllEmployees   Boolean  @default(false) @map("access_all_employees")
  isBlacklisted        Boolean  @default(false) @map("is_blacklisted")
  isActive             Boolean  @default(true) @map("is_active")
  isPinned             Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  region    DictionaryItem?  @relation(fields: [regionId], references: [id])
  employees Employee[]
  documents PersonDocument[]
  gphContracts GphContract[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, isPinned])
  @@map("persons")
}

model Employee {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  personId       String?          @map("person_id") @db.Uuid
  tabNumber      String           @map("tab_number")
  firstName      String           @map("first_name")
  lastName       String           @map("last_name")
  middleName     String?          @map("middle_name")
  email          String?
  phone          String?
  divisionId     String?          @map("division_id") @db.Uuid
  positionId     String?          @map("position_id") @db.Uuid
  gradeId        String?          @map("grade_id") @db.Uuid
  regionId       String?          @map("region_id") @db.Uuid
  staffPositionId String?         @map("staff_position_id") @db.Uuid
  dismissalReasonId String?       @map("dismissal_reason_id") @db.Uuid
  status         EmploymentStatus @default(active)
  employmentType EmploymentType   @default(staff) @map("employment_type")
  hiredAt        DateTime?        @map("hired_at") @db.Date
  dismissedAt    DateTime?        @map("dismissed_at") @db.Date
  /// Откуда пришел (Verifix analytics)
  employmentSource String?        @map("employment_source")
  /// Куда ушел после увольнения
  dismissalDestination String?    @map("dismissal_destination")
  /// Ключевой сотрудник
  isKeyEmployee  Boolean          @default(false) @map("is_key_employee")
  /// Уровень зарплаты относительно рынка
  salaryMarketLevel SalaryMarketLevel? @map("salary_market_level")
  externalId     String?          @map("external_id")
  scheduleId     String?          @map("schedule_id") @db.Uuid
  baseSalary     Decimal?         @map("base_salary") @db.Decimal(14, 2)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person   Person?       @relation(fields: [personId], references: [id])
  division Division?     @relation(fields: [divisionId], references: [id])
  position Position?     @relation(fields: [positionId], references: [id])
  schedule WorkSchedule? @relation(fields: [scheduleId], references: [id])
  grade            Grade?           @relation(fields: [gradeId], references: [id])
  region           DictionaryItem?  @relation(fields: [regionId], references: [id])
  staffPosition    StaffPosition?   @relation(fields: [staffPositionId], references: [id])
  dismissalReason  DismissalReason? @relation(fields: [dismissalReasonId], references: [id])

  marks      AttendanceMark[]
  days       AttendanceDay[]
  absences   Absence[]
  requests   HrRequest[]
  documents  HrDocument[]
  hrChangeRequests HrChangeRequest[]
  hrChangeRequestLines HrChangeRequestLine[]
  personDocuments PersonDocument[]
  faceProfile FaceProfile?
  payrollLines    PayrollLine[]
  payrollAdvances PayrollAdvance[]
  payrollAccrualLines PayrollAccrualLine[]
  payrollAccrualDeductions PayrollAccrualDeduction[]
  payrollSheetLines PayrollSheetLine[]
  clearanceSheets ClearanceSheet[]
  clearanceTemplateEmployees ClearanceTemplateEmployee[]
  absenceTypeEmployees AbsenceTypeEmployee[]
  incidents       Incident[]
  managedIncidents Incident[] @relation("IncidentManager")
  gradeHistory     EmployeeGradeHistory[]
  gradePromotionLines GradePromotionLine[]
  gradePromotionRecommendations GradePromotionRecommendation[]
  gphContracts     GphContract[]
  nameChanges      EmployeeNameChange[]
  wageChanges      WageChange[]
  timesheetAdjustments TimesheetAdjustment[]
  timesheetCorrectionLines TimesheetCorrectionLine[]
  timesheetSheetLines TimesheetSheetLine[]
  scheduleOverrides EmployeeScheduleOverride[]
  individualScheduleLines IndividualScheduleLine[]
  positionScheduleDocLines PositionScheduleDocLine[]
  workRosterLines WorkRosterLine[]
  shiftAssignments ScheduleShiftAssignment[]
  shiftReplacements ScheduleShiftAssignment[] @relation("ShiftReplacedBy")
  internalTrips    InternalTrip[]
  gpsTrackPoints   GpsTrackPoint[]
  paymentOrders    PaymentOrder[]
  settlements      Settlement[]
  salesCommissionLines SalesCommissionLine[]
  oneTimeAccrualLines OneTimeAccrualLine[]
  bonusAccrualLines   BonusAccrualLine[]
  facts            Fact[]
  loans            EmployeeLoan[]
  travelReports    TravelExpenseReport[]
  relatives        EmployeeRelative[]
  certificates     EmployeeCertificate[]
  tenures          EmployeeTenure[]
  workplaces       EmployeeWorkplace[]
  awards           EmployeeAward[]
  files            EmployeeFile[]
  inventoryItems   EmployeeInventory[]
  cars             EmployeeCar[]
  markBlocks       EmployeeMarkBlock[]
  accessGrants     EmployeeAccessGrant[]
  bankAccounts     EmployeeBankAccount[]
  bankCards        EmployeeBankCard[]
  managedDivisions Division[] @relation("DivisionManager")

  @@unique([tenantId, tabNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, dismissedAt])
  @@index([tenantId, employmentType])
  @@index([tenantId, externalId])
  @@index([tenantId, regionId])
  @@index([tenantId, lastName, firstName])
  @@map("employees")
}

/// Verifix: ordinary | hourly | advanced | multi_shift | advanced_multi_shift
enum WorkScheduleKind {
  ordinary
  hourly
  advanced
  multi_shift
  advanced_multi_shift
}

model WorkSchedule {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  code      String
  name      String
  kind      WorkScheduleKind @default(ordinary)
  startTime String           @default("09:00") @map("start_time")
  endTime   String           @default("18:00") @map("end_time")
  graceMinutes Int           @default(15) @map("grace_minutes")
  /// Verifix schedule knobs: weekPattern, graceOut, trackLate/Early, delayMode, yearGrid, …
  settings  Json?
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]
  divisions Division[]
  shifts    ScheduleShift[]
  overrides EmployeeScheduleOverride[]
  positionSchedules PositionSchedule[]
  staffPositions StaffPosition[]
  workRosters WorkRoster[]
  shiftAssignments ScheduleShiftAssignment[]
  internalTrips InternalTrip[]
  positionTemplates PositionTemplate[]
  allowancePolicies AllowancePolicy[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@map("work_schedules")
}

/// Verifix «Производственные календари»
model ProductionCalendar {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  code                 String
  name                 String
  year                 Int
  /// Weekend weekday numbers: 0=Sun … 6=Sat (JSON number[])
  weekendDays          Json     @default("[0,6]") @map("weekend_days")
  preHolidayHours      String?  @map("pre_holiday_hours")
  holidayHours         String?  @map("holiday_hours")
  dailyAttendance      String   @default("08:00") @map("daily_attendance")
  monthlyLimit         Boolean  @default(false) @map("monthly_limit")
  dailyLimit           Boolean  @default(false) @map("daily_limit")
  /// Cached totals from recalculate
  totals               Json?
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  days   ProductionCalendarDay[]

  @@unique([tenantId, code])
  @@index([tenantId, year])
  @@map("production_calendars")
}

enum ProdCalendarDayType {
  holiday
  day_off
  transfer
  short_day
  workday
}

model ProductionCalendarDay {
  id              String              @id @default(uuid()) @db.Uuid
  calendarId      String              @map("calendar_id") @db.Uuid
  day             DateTime            @db.Date
  dayType         ProdCalendarDayType @default(holiday) @map("day_type")
  name            String?
  replacementDay  DateTime?           @map("replacement_day") @db.Date
  hours           Decimal?            @db.Decimal(5, 2)

  calendar ProductionCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, day])
  @@index([calendarId])
  @@map("production_calendar_days")
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  locationTypeId String?  @map("location_type_id") @db.Uuid
  code           String
  name           String
  address        String?
  timezone       String   @default("Asia/Tashkent")
  latitude       Float?
  longitude      Float?
  geoRadiusM     Int      @default(150) @map("geo_radius_m")
  isActive       Boolean  @default(true) @map("is_active")
  /// Verifix extras: region, bssid, restrictMarks, polygonalAnalysis,
  /// createdByLabel, updatedByLabel, changeHistory[]
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationType  LocationType?  @relation(fields: [locationTypeId], references: [id])
  devices       Device[]
  qrCodes       QrCode[]
  internalTrips InternalTrip[]
  divisions     Division[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("locations")
}

model QrCode {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  locationId String?   @map("location_id") @db.Uuid
  code       String
  label      String
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("qr_codes")
}

model Device {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  locationId   String?   @map("location_id") @db.Uuid
  name         String
  serialNumber String    @map("serial_number")
  model        String?
  adapterType  String    @default("mock") @map("adapter_type")
  host         String?
  port         Int?
  username     String?
  passwordEnc  String?   @map("password_enc")
  status       String    @default("offline")
  lastSeenAt   DateTime? @map("last_seen_at")
  gatewayRef   String?   @map("gateway_ref")
  isActive     Boolean   @default(true) @map("is_active")
  /// Verifix extras: deviceType, timezone, battery, trackingType, autoIn/Out,
  /// hikCentral {gatewayHost,gatewayPort,deviceId,isupKey}, ignoredPersonIds[],
  /// ignoredDivisionIds[], commands[]
  meta         Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location  Location?        @relation(fields: [locationId], references: [id])
  marks     AttendanceMark[]
  faceSyncs DeviceFaceSync[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@map("devices")
}

model FaceProfile {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  employeeId   String         @unique @map("employee_id") @db.Uuid
  syncStatus   FaceSyncStatus @default(pending) @map("sync_status")
  photoUrl     String?        @map("photo_url")
  photoKey     String?        @map("photo_key")
  contentType  String?        @map("content_type")
  lastError    String?        @map("last_error")
  lastSyncedAt DateTime?      @map("last_synced_at")
