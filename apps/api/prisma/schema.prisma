  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cards    EmployeeBankCard[]

  @@index([tenantId, employeeId])
  @@map("employee_bank_accounts")
}

/// Verifix employee «Банковские карты»
model EmployeeBankCard {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  accountId       String?   @map("account_id") @db.Uuid
  cardNumber      String    @map("card_number")
  /// Расчетный счет (текст или с привязанного счёта)
  accountNumber   String    @default("") @map("account_number")
  /// Код банка / МФО
  bankCode        String    @default("") @map("bank_code")
  expiresAt       DateTime? @map("expires_at") @db.Date
  /// Состояние: active | blocked | expired
  state           String    @default("active")
  /// Статус: active | inactive
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  account  EmployeeBankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@map("employee_bank_cards")
}

model EmployeeAccessGrant {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  accessType String   @map("access_type")
  resource   String
  grantedAt  DateTime @default(now()) @map("granted_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean  @default(true) @map("is_active")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@map("employee_access_grants")
}

/// Виды рабочего времени (Verifix)
model TimeType {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  /// Буквенный код (short); code remains unique key
  letterCode  String?  @map("letter_code")
  digitalCode String?  @map("digital_code")
  /// full | partial | unplanned — Нагрузка на план
  planLoad    String   @default("partial") @map("plan_load")
  /// Calendar color hex
  color       String?
  parentId    String?  @map("parent_id") @db.Uuid
  isPaid      Boolean  @default(true) @map("is_paid")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       TimeType?  @relation("TimeTypeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     TimeType[] @relation("TimeTypeHierarchy")
  absenceTypes AbsenceType[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("time_types")
}

/// Шаблоны отчётов / документов (Verifix «Шаблоны отчетов»)
model ReportTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String
  name             String
  /// Внутренний/старый вид отчёта (t13, contract, …)
  kind             String   @default("document")
  /// Источник (документ-основание)
  source           String?
  sourceType       String?  @map("source_type")
  fileName         String?  @map("file_name")
  fileUrl          String?  @map("file_url")
  /// Группа шаблонов
  templateGroup    String?  @map("template_group")
  /// excel | word
  templateType     String   @default("excel") @map("template_type")
  sortOrder        Int      @default(0) @map("sort_order")
  useNameInReport Boolean @default(true) @map("use_name_in_report")
  /// Отображаемое «Создал» (System / user)
  createdBy        String?  @map("created_by")
  /// { variables: string[] }
  definition       Json?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("report_templates")
}
