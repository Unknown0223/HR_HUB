/// Verifix «Начисления» — виды начислений (справочник зарплаты)
model AccrualType {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  shortName   String?  @map("short_name")
  description String?
  /// Порядковый номер
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  /// Назначение начисления (текст / справочник)
  purpose     String?

  /// period | day | shift — тип расчета за период
  periodCalc  String   @default("period") @map("period_calc")
  /// formula | fixed — расчет и показатели
  resultMode  String   @default("formula") @map("result_mode")
  formula     String?

  /// Налоги / взносы
  taxNdfl     Boolean  @default(true) @map("tax_ndfl")
  taxInps     Boolean  @default(false) @map("tax_inps")
  taxOss      Boolean  @default(false) @map("tax_oss")
  /// employee | operation — бухгалтерский учет
  accountingMode String @default("employee") @map("accounting_mode")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accrual_types")
}

/// Verifix «Удержания» — виды удержаний (справочник зарплаты)
model DeductionType {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  shortName   String?  @map("short_name")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  /// Назначение (текст)
  purpose     String?

  /// period | day | shift
  periodCalc  String   @default("period") @map("period_calc")
  /// formula | fixed
  resultMode  String   @default("formula") @map("result_mode")
  formula     String?

  /// employee | operation — бухгалтерский учет
  accountingMode String @default("employee") @map("accounting_mode")
  /// Счет (когда accountingMode = operation)
  account     String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("deduction_types")
}

/// Verifix «Типы фактов» (продажи Billz/iiko и др.)
model FactType {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  /// Единица измерения
  unit        String   @default("Количество")
  parentId    String?  @map("parent_id") @db.Uuid
  accrualName String?  @map("accrual_name")
  /// Реестр: [{ startDate, endDate, cycleTime, price }]
  registry    Json?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   FactType? @relation("FactTypeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children FactType[] @relation("FactTypeHierarchy")
  facts     Fact[]
  bonusDocs BonusAccrualDoc[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("fact_types")
}

/// Verifix «Факты» — факт по сотруднику (импорт Excel)
