# NestJS API
DATABASE_URL=postgresql://hrhub:hrhub_dev@127.0.0.1:5434/hrhub?schema=public
# Prod: long random (≥32). NODE_ENV=production refuses weak/default secrets.
JWT_SECRET=change-me-phase0-dev-secret-min-32-chars!!
JWT_EXPIRES_IN=7d
API_PORT=3002
# Comma-separated allow-list (never * with credentials in prod)
CORS_ORIGIN=http://localhost:3001
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Punch ingest key (POST /api/attendance/punches/ingest and heartbeats/ingest).
# Local/dev: leave empty to keep lab ingest open.
# Production (NODE_ENV=production): REQUIRED — API will not start without it.
# Callers send header X-Punch-Key: <same value> (device-gw: DEVICE_GW_PUNCH_KEY).
# PUNCH_INGEST_API_KEY=
# Optional per-IP rate limit (req/min). 0 or unset = disabled (lab/demo)
# PUNCH_INGEST_RATE_LIMIT_PER_MIN=120
# Soft-purge face photos N days after dismiss (Nest cron 03:00). Unset/0 = off.
# FACE_PURGE_DAYS=90
