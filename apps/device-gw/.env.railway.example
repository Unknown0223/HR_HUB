# Copy to apps/device-gw/.env and fill Railway API URL + punch key.
DEVICE_GW_PORT=8800
DEVICE_GW_HOST=0.0.0.0
DEVICE_GW_API_URL=https://REPLACE-api.up.railway.app
DEVICE_GW_PUNCH_KEY=REPLACE_WITH_PUNCH_INGEST_API_KEY
DEVICE_GW_NATS_URL=nats://127.0.0.1:4222
DEVICE_GW_NATS_SUBJECT=hrhub.punch.raw
DEFAULT_ADAPTER=hikvision_isapi
