<?xml version="1.0" encoding="utf-8"?>
<!-- LAN Hikvision ISAPI uses http://192.168.x.x — cleartext required for device IPs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
