# ── Shared / infra ──────────────────────────────────────────
POSTGRES_USER=hrhub
POSTGRES_PASSWORD=hrhub_dev
POSTGRES_DB=hrhub
POSTGRES_PORT=5434

REDIS_PORT=6379
NATS_PORT=4222
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── API (NestJS) ────────────────────────────────────────────
DATABASE_URL=postgresql://hrhub:hrhub_dev@127.0.0.1:5434/hrhub?schema=public
JWT_SECRET=change-me-phase0-dev-secret-min-32-chars!!
JWT_EXPIRES_IN=7d
API_PORT=3002
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hrhub
# Comma-separated allow-list (prod: exact web origins)
CORS_ORIGIN=http://localhost:3001
# Punch ingest key — local may be empty; production (NODE_ENV=production) REQUIRED
# See docs/SECURITY_CHECKLIST.md
# PUNCH_INGEST_API_KEY=
# Optional per-IP rate limit (req/min). 0 or unset = disabled (lab/demo)
# PUNCH_INGEST_RATE_LIMIT_PER_MIN=120
# Face retention soft-purge for dismissed employees (days). Unset/0 = disabled (lab).
# Nest cron daily 03:00 when API is running; or: npm run face:purge
# FACE_PURGE_DAYS=90

# ── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3002
WEB_PORT=3001

# ── Device Gateway (FastAPI) ────────────────────────────────
DEVICE_GW_PORT=8800
DEVICE_GW_NATS_URL=nats://localhost:4222
# Nest API (local or Railway HTTPS) — used for HTTP punch ingest
DEVICE_GW_API_URL=http://localhost:3002
DEVICE_GW_PUNCH_KEY=
# API → GW (local or Cloudflare tunnel URL when API is on Railway)
DEVICE_GW_URL=http://127.0.0.1:8800
