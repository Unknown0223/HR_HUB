{
  "name": "hr-hub",
  "version": "0.1.0",
  "private": true,
  "description": "HR HUB — multi-tenant HR + attendance + payroll platform (Phase 0)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:api": "npm run start:dev -w @hr-hub/api",
    "dev:web": "npm run dev -w @hr-hub/web",
    "dev:gw": "node scripts/run-device-gw.js",
    "devices:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/link-devices.ps1",
    "office-link:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/office-link/link.ps1 -Mode admin",
    "office-link": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/office-link/link.ps1 -Mode field",
    "dev:apps": "node scripts/dev-apps.js",
    "build:api": "npm run build -w @hr-hub/api",
    "build:web": "npm run build -w @hr-hub/web",
    "db:generate": "npm run prisma:generate -w @hr-hub/api",
    "db:migrate": "npm run prisma:migrate -w @hr-hub/api",
    "db:seed": "npm run prisma:seed -w @hr-hub/api",
    "db:push": "npm run prisma:push -w @hr-hub/api",
    "backlog": "node scripts/generate-backlog.js",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "infra:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "smoke": "node scripts/smoke-test.js",
    "smoke:me": "node scripts/smoke-me-api.js",
    "smoke:schedules": "node scripts/smoke-individual-schedules.js",
    "smoke:position-schedules": "node scripts/smoke-position-schedules.js",
    "smoke:rosters": "node scripts/smoke-rosters.js",
    "smoke:roster-change": "node scripts/smoke-roster-change-requests.js",
    "smoke:shift-assignments": "node scripts/smoke-shift-assignments.js",
    "smoke:system-settings": "node scripts/smoke-system-settings.js",
    "smoke:employment-sources": "node scripts/smoke-employment-sources.js",
    "smoke:indicators": "node scripts/smoke-indicators.js",
    "smoke:avg-salaries": "node scripts/smoke-avg-salaries.js",
    "smoke:coa": "node scripts/smoke-coa.js",
    "smoke:cashboxes": "node scripts/smoke-cashboxes.js",
    "smoke:currencies": "node scripts/smoke-currencies.js",
    "smoke:nationality": "node scripts/smoke-nationality.js",
    "smoke:artix": "node scripts/smoke-artix.js",
    "smoke:iiko": "node scripts/smoke-iiko.js",
    "smoke:iiko-sales": "node scripts/smoke-iiko-sales.js",
    "smoke:billz": "node scripts/smoke-billz.js",
    "smoke:billz1": "node scripts/smoke-billz1.js",
    "smoke:organizations": "node scripts/smoke-organizations.js",
    "smoke:users-admin": "node scripts/smoke-users-admin.js",
    "smoke:countries": "node scripts/smoke-countries.js",
    "smoke:banks": "node scripts/smoke-banks.js",
    "smoke:quickstart": "node scripts/smoke-quickstart.js",
    "smoke:photos": "node scripts/smoke-photos.js",
    "smoke:person-docs": "node scripts/smoke-person-docs.js",
    "smoke:fine-policies": "node scripts/smoke-fine-policies.js",
    "smoke:fine-policies-fullstack": "node scripts/smoke-fine-policies-fullstack.js",
    "smoke:allowance-policies": "node scripts/smoke-allowance-policies.js",
    "smoke:allowance-policies-fullstack": "node scripts/smoke-allowance-policies-fullstack.js",
    "smoke:timesheets": "node scripts/smoke-timesheets.js",
    "smoke:timesheets-fullstack": "node scripts/smoke-timesheets-fullstack.js",
    "smoke:accruals": "node scripts/smoke-accruals.js",
    "smoke:accruals-fullstack": "node scripts/smoke-accruals-fullstack.js",
    "smoke:settlements": "node scripts/smoke-settlements.js",
    "smoke:settlements-fullstack": "node scripts/smoke-settlements-fullstack.js",
    "smoke:vedomost": "node scripts/smoke-vedomost.js",
    "smoke:vedomost-fullstack": "node scripts/smoke-vedomost-fullstack.js",
    "smoke:manual-ops": "node scripts/smoke-manual-ops.js",
    "smoke:manual-ops-fullstack": "node scripts/smoke-manual-ops-fullstack.js",
    "smoke:gph-services": "node scripts/smoke-gph-services.js",
    "smoke:gph-services-fullstack": "node scripts/smoke-gph-services-fullstack.js",
    "smoke:sales-accruals": "node scripts/smoke-sales-accruals.js",
    "smoke:sales-accruals-fullstack": "node scripts/smoke-sales-accruals-fullstack.js",
    "smoke:one-time-accruals": "node scripts/smoke-one-time-accruals.js",
    "smoke:one-time-accruals-fullstack": "node scripts/smoke-one-time-accruals-fullstack.js",
    "smoke:loans": "node scripts/smoke-loans.js",
    "smoke:loans-fullstack": "node scripts/smoke-loans-fullstack.js",
    "smoke:payment-orders": "node scripts/smoke-payment-orders.js",
    "smoke:payment-orders-fullstack": "node scripts/smoke-payment-orders-fullstack.js",
    "smoke:travel-expenses": "node scripts/smoke-travel-expenses.js",
    "smoke:travel-expenses-fullstack": "node scripts/smoke-travel-expenses-fullstack.js",
    "smoke:bonus-accruals": "node scripts/smoke-bonus-accruals.js",
    "smoke:bonus-accruals-fullstack": "node scripts/smoke-bonus-accruals-fullstack.js",
    "smoke:payroll": "node scripts/smoke-payroll-links.js",
    "smoke:payroll-fullstack": "node scripts/smoke-payroll-fullstack.js",
    "smoke:verifix-reports": "node scripts/smoke-verifix-reports.js",
    "smoke:extra-fullstack": "node scripts/smoke-extra-fullstack.js",
    "face:purge": "node scripts/face-purge.js",
    "infra:prod": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml --env-file .env.prod up -d",
    "load:punch": "node scripts/load-punch-test.js",
    "load:punch:medium": "node scripts/load-punch-test.js --profile medium",
    "load:punch:heavy": "node scripts/load-punch-test.js --profile heavy --write-results",
    "verifix:gather": "python scripts/verifix-gather.py",
    "verifix:dump-live": "python scripts/_vf_live_dump.py",
    "verifix:import": "node apps/api/scripts/import-verifix-dump.js",
    "verifix:import-live": "node apps/api/scripts/import-verifix-live.js",
    "verifix:import-live-extra": "node apps/api/scripts/import-verifix-live-extra.js",
    "attendance:purge": "node apps/api/scripts/purge-attendance.js",
    "verifix:bootstrap": "python scripts/verifix-bootstrap.py",
    "verifix:pack": "python scripts/verifix-pack-transfer.py",
    "verifix:restore": "python scripts/verifix-pack-transfer.py --restore",
    "verifix:photos": "python scripts/_vf_live_photos.py && node apps/api/scripts/import-verifix-photos.js"
  },
  "engines": {
    "node": ">=20"
  }
}
